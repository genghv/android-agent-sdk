# 构建产物与本地工具链（不进仓库）
.toolchain/
build/
.gradle/
.kotlin/
out/
.idea/
*.iml

# 本机路径（sdk.dir 指向本机 Android SDK，换机器必失效）
# 改用环境变量 ANDROID_HOME 也行 —— 二选一即可。
local.properties

# 大压缩包不进仓库。
#
# ★ bootstrap-aarch64-lean.zip 是 **Termux 的 GPLv3 运行时载荷**（~22MB）：
#   它以 Release 附件的形式单独分发，不进 git 历史。
#   取法与许可义务见 bootstrap/README.md。
*.zip

# 闭源产物解出来的 classes.jar（由 scripts/verify-cipher-contract.ps1 生成）。
# ⚠️ 它是**闭源实现**的字节 ⇒ 绝不能进仓库（仓库里只留契约，不留实现）。
cipher-contract-test/libs/

# demo 宿主自己放的闭源加密核心（.aar）。
# ⚠️ 同上：**闭源字节绝不能进仓库** —— demo 只留「怎么放、放哪、期望指纹是多少」的说明。
agent-sdk-demo/app/libs/*.aar
